# Copy to `.env` and fill with your Supabase project values.
# Dashboard → Project Settings → API Keys → "Publishable and secret API keys"
# Docs: https://supabase.com/docs/guides/getting-started/api-keys

# Project root URL only — do NOT include /rest/v1
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Preferred (future-proof) — low privilege, safe in the browser
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Preferred (future-proof) — elevated, server-only (never ship to the browser)
SUPABASE_SECRET_KEY=sb_secret_...

# Encrypts connection credentials at rest (server-only). Use a long random string.
CONNECTOR_SECRETS_KEY=change-me-to-a-long-random-string

# Optional — LLM-assisted connector type generation (platform admin)
# Prefer Gemini:
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key.
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Or OpenAI-compatible:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Restart `npm run dev` after changing .env

# ---------------------------------------------------------------------------
# Legacy fallbacks (anon / service_role JWTs) — supported until end of 2026.
# NUXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
