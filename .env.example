# Copy to `.env` and fill with your Supabase project values.
# Dashboard → Project Settings → API Keys → "Publishable and secret API keys"
# Docs: https://supabase.com/docs/guides/getting-started/api-keys

# Project root URL only — do NOT include /rest/v1
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Preferred (future-proof) — low privilege, safe in the browser
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Preferred (future-proof) — elevated, server-only (never ship to the browser)
SUPABASE_SECRET_KEY=sb_secret_...

# Server-only — legacy HS256 JWT secret (Dashboard → API → JWT Secret).
# Only needed for older projects still on symmetric signing keys.
# SUPABASE_JWT_SECRET=your-jwt-secret

# Cached JWKS for ES256/RS256 signing keys — required on corporate VPN / TLS inspection.
# Fetch while off VPN: bash scripts/fetch-supabase-jwks.sh
# SUPABASE_JWKS_JSON='{"keys":[...]}'

# Encrypts connection credentials at rest (server-only). Use a long random string.
CONNECTOR_SECRETS_KEY=change-me-to-a-long-random-string

# HMAC secret for licence tokens (server-only). Prefer a dedicated value;
# falls back to SUPABASE_SECRET_KEY if unset. Never expose to the client.
LICENCE_SIGNING_SECRET=change-me-to-a-long-random-licence-secret

# Optional — LLM-assisted connector type generation (platform admin)
# Prefer Gemini:
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key.
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Or OpenAI-compatible:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Restart `npm run dev` after changing .env

# Optional — local Postgres warehouse for organizations with ingest_backend = 'local'.
# Server-only. Bootstrap: see supabase/LOCAL_INGEST_BOOTSTRAP.md
# INGEST_DATABASE_URL=postgres://user:pass@127.0.0.1:5433/ingest_warehouse

# Optional — allow platform admins to run `npm install` for DB drivers from the UI
# (enabled automatically in development). Self-hosted production only.
# ALLOW_PLATFORM_DRIVER_INSTALL=true

# ---------------------------------------------------------------------------
# Legacy fallbacks (anon / service_role JWTs) — supported until end of 2026.
# NUXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
